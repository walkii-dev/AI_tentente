# Google Gemini AI API Configuration
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_aqui

# Modelos recomendados: gemini-2.5-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Parâmetros opcionais
TEMPERATURE=0.7
MAX_OUTPUT_TOKENS=2048

# Skill/Comportamento do Robô (arquivo dentro de ./skills/)
ACTIVE_SKILL=support_agent.md

# Telegram Bot Configuration
# Obtenha o token criando um bot com o @BotFather no Telegram
TELEGRAM_BOT_TOKEN=seu_token_do_telegram_aqui

# Regras de Transbordo para Atendente Humano
HANDOFF_THRESHOLD=15
SUPPORT_START_HOUR=9
SUPPORT_END_HOUR=18
