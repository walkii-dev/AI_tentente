# Google Gemini API Configuration
GEMINI_API_KEY=sua_chave_aqui

# Modelos recomendados(para o Gemini, pode usar outro): gemini-3.5-flash-lite, gemini-2.5-flash-lite. 
GEMINI_MODEL=gemini-2.5-flash-lite

# Telegram Bot Configuration
# Chave gerada pelo @BotFather no Telegram
TELEGRAM_BOT_TOKEN=seu_token_do_telegram_aqui

# Parâmetros opcionais
TEMPERATURE=0.7
MAX_OUTPUT_TOKENS=2048

# Comportamento geral do Robô (arquivo dentro de ./skills/)
ACTIVE_SKILL=support_agent.md


